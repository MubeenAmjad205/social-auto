# Local dev secrets for `wrangler dev`. Copy this file to `.dev.vars`
# (gitignored) and fill in real values as you get them.
#
# These are SECRETS -> in production they go via `wrangler secret put` (or
# `wrangler secret bulk secrets.json`, see secrets.example.json), never in
# wrangler.jsonc. Non-secret vars (CLOUDINARY_CLOUD_NAME, LINKEDIN_VERSION,
# LINKEDIN_REDIRECT_URI, INSTAGRAM_REDIRECT_URI, THREADS_REDIRECT_URI,
# ENABLED_PLATFORMS, MASTODON_INSTANCE_URL, MASTODON_MAX_CHARS,
# ALERT_EMAIL_TO, IMAGE_MODEL, TEXT_MODEL, MONGODB_DB) already live in
# wrangler.jsonc's "vars" block and don't belong here.

# Non-SRV multi-host string. Atlas -> Connect -> Drivers -> "Node.js 2.2.12
# or later". mongodb+srv:// WILL NOT resolve in workerd.
MONGODB_URI=

# base64, 32 bytes. Encrypts OAuth tokens at rest (src/secrets.ts).
# Generate: openssl rand -base64 32
TOKEN_KEY=

# From the LinkedIn developer app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# The Meta App's Instagram API "App ID"/secret (API setup with Instagram
# login screen, not the general Facebook Login product). There is no
# IG_USER_ID secret anymore — visiting /auth/instagram captures the IG
# business user id automatically and stores it with the token. See docs/setup/instagram.md.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Same Meta App as Instagram, with the Threads product added — same
# App ID/Secret shape. See docs/setup/threads.md. Only needed if "threads"
# is in ENABLED_PLATFORMS.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# Settings -> App Passwords on bsky.app — NOT your real account password.
# Only needed if "bluesky" is in ENABLED_PLATFORMS. See docs/setup/bluesky.md.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Generated once in your Mastodon instance's Settings -> Development ->
# New Application — no OAuth flow needed. Only needed if "mastodon" is in
# ENABLED_PLATFORMS. See docs/setup/mastodon.md.
MASTODON_ACCESS_TOKEN=

# Cloudinary dashboard home page, next to CLOUDINARY_CLOUD_NAME (a var in
# wrangler.jsonc, not here — it's not sensitive). Hosts every generated
# image, replacing R2. See docs/setup/cloudinary.md and src/cloudinary-storage.ts.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPTIONAL — only needed if "gemini" appears in the IMAGE_PROVIDER fallback
# chain in wrangler.jsonc. Leaving this blank is safe: that provider just
# fails fast and the chain falls through to the next one (see
# src/image-providers.ts). Free, no card: aistudio.google.com/apikey.
GEMINI_API_KEY=

# OPTIONAL — last-resort email alert if Telegram itself fails to deliver a
# message. Leave both blank to skip entirely; notify() still works via
# Telegram either way. Gmail: myaccount.google.com/apppasswords (needs 2FA
# on the account first). See docs/setup/email.md and src/email.ts.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GitHub personal access token — raises the search API limit 60/hr -> 5,000/hr
# (src/research.ts). Read-only is fine; it doesn't host images (Cloudinary does).
GITHUB_PAT=

# https://app.tavily.com — 1,000 free credits/month, no card required.
TAVILY_API_KEY=

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# From @userinfobot — this is YOUR chat id, so only you can approve drafts.
TELEGRAM_CHAT_ID=

# Unguessable path segment for the Telegram webhook: POST /tg/<this>.
# Anyone holding this URL can approve/reject drafts. Generate:
# openssl rand -hex 24
WEBHOOK_SECRET=
