{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // nodejs_compat is REQUIRED for the mongodb driver — it needs node:net and
  // node:tls, both of which workerd now implements. Do not remove it.
  "compatibility_flags": ["nodejs_compat"],

  // Free plan: 5 Cron Triggers per account. Still exactly 5, regardless of
  // how many platforms ENABLED_PLATFORMS turns on below — see src/index.ts's
  // header comment for how generate/publish got consolidated to make that
  // true. ALL TIMES ARE UTC. You are UTC+5 (PKT) — subtract 5 from local time.
  "triggers": {
    "crons": [
      "0 2 * * *",   // 07:00 PKT — generate every enabled TEXT platform from one seed, send to Telegram
      "0 4 * * *",   // 09:00 PKT — publish anything approved, every enabled platform
      "0 6 * * *",   // 11:00 PKT — generate Instagram carousel, send to Telegram
      "0 9 * * *",   // 14:00 PKT — publish anything approved, every enabled platform (2nd window, catches Instagram)
      "0 22 * * *"   // 03:00 PKT — token health + seed queue check, every enabled platform
    ]
  },

  "ai": { "binding": "AI" },

  // Bundler rules for binary assets used by the Instagram carousel renderer
  // (src/carousel.ts + src/rasterize.ts): the resvg WASM binary and the two
  // embedded font weights it rasterizes text with.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  "vars": {
    // DUMMY — "owner/repo" of a small DEDICATED public GitHub repo (not the
    // code repo) used to host every generated image. Replaces R2 entirely —
    // R2 needed a Cloudflare billing profile (a card) just to activate; this
    // needs none. See src/github-storage.ts and docs/setup/github-media.md.
    "GITHUB_MEDIA_REPO": "REPLACE-ME-your-username/social-media",

    // Mandatory on /rest/* calls. Versions are sunset on a rolling basis —
    // bump this quarterly and re-test.
    "LINKEDIN_VERSION": "202608",

    // TEMPORARY — pointed at a local ngrok tunnel for OAuth testing against
    // `wrangler dev` (ngrok http 8787). Free-tier ngrok URLs change every
    // time the tunnel restarts — when that happens, update this AND the
    // matching redirect URL registered on the LinkedIn app, and re-run
    // `wrangler dev`. Switch to the real workers.dev URL from `wrangler
    // deploy` (`wrangler whoami`) once you're done testing locally.
    "LINKEDIN_REDIRECT_URI": "https://89d5-163-61-128-174.ngrok-free.app/auth/linkedin/callback",

    // Same ngrok tunnel, registered on the Instagram product's API setup
    // screen in the Meta App dashboard (docs/setup/instagram.md step 4).
    "INSTAGRAM_REDIRECT_URI": "https://89d5-163-61-128-174.ngrok-free.app/auth/instagram/callback",

    // Same ngrok tunnel again, registered on the Threads product added to
    // the SAME Meta App as Instagram. See docs/setup/threads.md.
    "THREADS_REDIRECT_URI": "https://89d5-163-61-128-174.ngrok-free.app/auth/threads/callback",

    // Comma-separated, no spaces needed. Default matches this project's
    // original behavior exactly — add "bluesky", "threads", "mastodon" as
    // you set each one up. A platform absent here costs nothing: no cron
    // work, no secrets required, no Telegram messages. See src/platforms.ts.
    "ENABLED_PLATFORMS": "linkedin,instagram",

    // Mastodon is federated — there's no single API host. Whatever server
    // your account lives on. See docs/setup/mastodon.md.
    "MASTODON_INSTANCE_URL": "https://REPLACE-ME.example.social",
    // Optional. Mastodon's default is 500; some instances allow more.
    "MASTODON_MAX_CHARS": "500",

    // Optional — destination address for the email fallback (src/email.ts).
    // Leave blank to leave the fallback off entirely; notify() still works
    // via Telegram either way, this only matters if Telegram itself fails.
    "ALERT_EMAIL_TO": "",

    // See docs/09-resources.md for the neuron math behind these.
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "TEXT_MODEL": "@cf/openai/gpt-oss-20b",

    // Optional swap for the LinkedIn post image — see src/image-providers.ts.
    // "workers-ai" (default): FLUX.2 above, costs Workers AI neurons, supports
    //   style_refs for visual consistency across posts.
    // "pollinations": free, no API key at all, but no style_refs and may
    //   carry a small watermark on anonymous requests.
    // "gemini": free (~500 images/day), needs a GEMINI_API_KEY secret, no
    //   style_refs, generally higher quality than FLUX schnell/klein.
    "IMAGE_PROVIDER": "workers-ai",

    "MONGODB_DB": "social"
  }

  // Secrets — `wrangler secret put <NAME>`. NEVER in this file.
  //
  //   MONGODB_URI            non-SRV multi-host string (mongodb+srv WILL NOT RESOLVE)
  //   TOKEN_KEY               base64 32 bytes: openssl rand -base64 32
  //   LINKEDIN_CLIENT_ID
  //   LINKEDIN_CLIENT_SECRET
  //   INSTAGRAM_CLIENT_ID    the Meta App's Instagram API "App ID" — NOT IG_USER_ID,
  //                          which no longer exists as a secret. See src/instagram.ts:
  //                          visiting /auth/instagram now captures the IG business user
  //                          id automatically and stores it on the token document.
  //   INSTAGRAM_CLIENT_SECRET
  //   THREADS_CLIENT_ID      OPTIONAL — only if "threads" is in ENABLED_PLATFORMS.
  //                          Same Meta App as Instagram, Threads product added.
  //   THREADS_CLIENT_SECRET
  //   BLUESKY_HANDLE         OPTIONAL — only if "bluesky" is in ENABLED_PLATFORMS.
  //                          Settings -> App Passwords on bsky.app, NOT your real password.
  //   BLUESKY_APP_PASSWORD
  //   MASTODON_ACCESS_TOKEN  OPTIONAL — only if "mastodon" is in ENABLED_PLATFORMS.
  //                          Generated once in your instance's Settings -> Development.
  //   GEMINI_API_KEY         OPTIONAL — only needed if IMAGE_PROVIDER is set to "gemini"
  //                          above. Free, no card: aistudio.google.com/apikey
  //   GMAIL_USER             OPTIONAL — email fallback if Telegram delivery fails. Both
  //   GMAIL_APP_PASSWORD     blank = fallback off entirely. See docs/setup/email.md.
  //   GITHUB_PAT             needs contents:write (fine-grained) or classic `repo` scope
  //                          now — image hosting pushes commits, not just reads for search.
  //   TAVILY_API_KEY
  //   TELEGRAM_BOT_TOKEN
  //   TELEGRAM_CHAT_ID
  //   WEBHOOK_SECRET
}
